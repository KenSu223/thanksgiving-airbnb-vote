{
  "name": "thanksgiving-airbnb-vote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --compatibility-date 2026-04-01",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:robustness": "node tests/robustness/run.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "canvas-confetti": "1.9.3",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11",
    "wrangler": "4.86.0"
  }
}
